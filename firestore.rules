rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRegistered() {
      return isAuthenticated() && !isAnonymous();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    function isExistingDocOwner() {
      return isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    function isDocUser() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    function isExistingDocUser() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Cross-document league ownership check (used for season/player/result scoping)
    function ownsLeague(leagueId) {
      return isRegistered() &&
        get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerId == request.auth.uid;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // User Settings
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Leagues
    match /leagues/{leagueId} {
      // get vs list, deliberately split. A participant arriving by QR knows the
      // leagueId from the tournament document and needs to read that one league
      // to resolve activeSeasonId — the pointer to which season standings belong
      // to. Enumerating every league stays owner-only, which was the actual
      // concern: a single get by known id discloses only a name and an owner id.
      allow get: if true;
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isRegistered() && isDocOwner()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 100;
      allow update: if isRegistered() && isExistingDocOwner()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 100;
      allow delete: if isRegistered() && isExistingDocOwner();
    }

    // Seasons / League Players / Tournament Results
    // Public read so QR participants see live standings before anonymous auth
    // completes. Update and delete are owner-scoped via ownsLeague().
    //
    // KNOWN GAP: create checks only isRegistered(), so any account that learns a
    // leagueId can add documents to that league. Tightening this to ownsLeague()
    // was tried and reverted: after a transfer-code handover the new director is
    // registered but does not own the league, yet useLeague still resolves
    // currentLeagueId from the tournament's stored leagueId — so their result
    // writes were denied, silently, with results simply never recorded.
    //
    // Silent data loss during a live game is worse than the forged-write risk,
    // which needs an authenticated attacker who has gone looking for a leagueId.
    // The proper fix is to authorise by tournament rather than by league: results
    // already carry tournamentId, so a rule can verify the writer is the current
    // director of a tournament belonging to that league. leaguePlayers writes
    // need a tournamentId adding before that can cover them too.
    // See the director-handover test in tests/rules/firestore.rules.test.ts.
    match /seasons/{seasonId} {
      allow read: if true;
      allow create: if isRegistered() && request.resource.data.leagueId is string;
      allow update: if ownsLeague(resource.data.leagueId);
      allow delete: if ownsLeague(resource.data.leagueId);
    }

    match /leaguePlayers/{playerId} {
      allow read: if true;
      allow create: if isRegistered() && request.resource.data.leagueId is string;
      allow update: if ownsLeague(resource.data.leagueId);
      allow delete: if ownsLeague(resource.data.leagueId);
    }

    match /tournamentResults/{resultId} {
      allow read: if true;
      allow create: if isRegistered() && request.resource.data.leagueId is string;
      allow update: if ownsLeague(resource.data.leagueId);
      allow delete: if ownsLeague(resource.data.leagueId);
    }

    // Active Tournaments
    // - Any authenticated user can read (anonymous QR participants included)
    // - Only a registered owner can create
    // - Owner can change anything
    // - Authenticated non-owners can update a restricted set of timer/player fields
    //   but cannot change ownerId — that would allow privilege escalation
    match /activeTournaments/{tournamentId} {
      allow read: if true;
      allow create: if isRegistered() && isDocOwner();
      allow update: if (
        // Owner can change anything
        isAuthenticated() && isExistingDocOwner()
      ) || (
        // Authenticated participants can update timer/player/transfer fields only.
        // ownerId is intentionally excluded to prevent privilege escalation.
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['players', 'currentLevel', 'secondsLeft', 'isRunning', 'notes',
                    'targetEndTime', 'smallBlind', 'bigBlind', 'ante', 'blindLevels'])
      ) || (
        // Unauthenticated player claiming (PlayerClaimView check-in via QR).
        // Only the players field may change, AND the array length must be
        // preserved. Without the size check this branch let anyone holding a
        // tournament id — which is handed to every participant in the QR code —
        // replace the entire players array: wiping the field mid-tournament, or
        // injecting entries that then feed through into league standings.
        //
        // Preserving size blocks deletion and injection. It does not prevent a
        // determined participant from altering fields within an existing entry;
        // closing that fully requires authenticating this write, which is
        // deliberately deferred — see the note in PlayerClaimView.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
        && request.resource.data.players.size() == resource.data.players.size()
      );
      allow delete: if isRegistered() && isExistingDocOwner();
    }

    // League Settings
    // Public read, matching seasons/leaguePlayers/tournamentResults above.
    // The participant view renders standings using the DIRECTOR's points system,
    // so RealTimeLeagueTable reads the director's settings doc as an anonymous
    // user. Restricting read to the owner silently denied that and fell back to
    // DEFAULT_LEAGUE_SETTINGS, so participants could be shown different points
    // totals than the director. These documents hold points formulas and column
    // display preferences — no personal or sensitive data.
    // Writes remain owner-only.
    match /leagueSettings/{settingId} {
      allow read: if true;
      allow create: if isRegistered() && isDocUser();
      allow update: if isRegistered() && isExistingDocUser()
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isRegistered() && isExistingDocUser();
    }

    // Transfer Codes — server-only.
    //
    // Director handover codes. No client may read or write these: the code is
    // the credential for taking over a tournament, and activeTournaments is
    // world-readable, so keeping the code there meant every participant who
    // scanned the QR could read it and seize control.
    //
    // Both halves of handover run through /api/transfer-code and
    // /api/claim-tournament using the Admin SDK, which bypasses these rules.
    // That is also why ownerId stays absent from every activeTournaments
    // update branch above — clients never write it.
    match /transferCodes/{tournamentId} {
      allow read, write: if false;
    }

    // Completed Tournaments — private history, owner only.
    // Not publicly readable: unlike live standings these are a personal record
    // and participants have no reason to read them.
    match /completedTournaments/{recordId} {
      allow read: if isRegistered() && resource.data.ownerId == request.auth.uid;
      allow create: if isRegistered() && isDocOwner();
      allow update: if isRegistered() && isExistingDocOwner() && isDocOwner();
      allow delete: if isRegistered() && isExistingDocOwner();
    }

    // Tournament Templates — owner only
    match /tournamentTemplates/{templateId} {
      allow read: if isRegistered() && resource.data.ownerId == request.auth.uid;
      allow create: if isRegistered() && isDocOwner();
      allow update: if isRegistered() && isExistingDocOwner() && isDocOwner();
      allow delete: if isRegistered() && isExistingDocOwner();
    }
  }
}
