rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRegistered() {
      return isAuthenticated() && !isAnonymous();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    function isExistingDocOwner() {
      return isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    function isDocUser() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    function isExistingDocUser() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Cross-document league ownership check (used for season/player/result scoping)
    function ownsLeague(leagueId) {
      return isRegistered() &&
        get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerId == request.auth.uid;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    //
    // READ-ONLY to clients. This document holds subscriptionStatus, and its only
    // writer is the Stripe webhook via the Admin SDK, which bypasses these rules
    // entirely. Nothing in the client writes this collection at all.
    //
    // It used to allow the owner to create and update their own document, which
    // meant any account could grant itself { subscriptionStatus: 'pro' } from the
    // browser console. Harmless while payments were off; it had to be closed
    // BEFORE they were switched on, not after.
    match /users/{userId} {
      allow read: if isOwner(userId);
    }

    // User Settings
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Leagues
    match /leagues/{leagueId} {
      // get vs list, deliberately split. A participant arriving by QR knows the
      // leagueId from the tournament document and needs to read that one league
      // to resolve activeSeasonId — the pointer to which season standings belong
      // to. Enumerating every league stays owner-only, which was the actual
      // concern: a single get by known id discloses only a name and an owner id.
      allow get: if true;
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isRegistered() && isDocOwner()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 100;
      allow update: if isRegistered() && isExistingDocOwner()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 100;
      allow delete: if isRegistered() && isExistingDocOwner();
    }

    // Seasons / League Players / Tournament Results
    //
    // Public read so QR participants see live standings before anonymous auth
    // completes. Every WRITE is scoped to the league's owner, create included.
    //
    // Create used to check only isRegistered(), so any account that learned a
    // leagueId could add seasons, players and results to a league it had nothing
    // to do with. Tightening it was tried and reverted once, because back then a
    // director could receive a tournament belonging to ANOTHER account's league
    // mid-game, and the rule silently denied their result writes with nothing on
    // screen. That flow is gone: handing a game over now means logging out so the
    // next director signs in with the SAME account, which owns the league by
    // construction. The objection expired with the feature.
    //
    // ownsLeague() reads the league document, so these writes cost one extra
    // read each and fail closed if the league is missing.
    //
    // Note create is checked against request.resource (the document being
    // written) and update/delete against resource (the one already stored) —
    // there is no stored document to consult on a create.
    //
    // leagueId is PINNED on update, and that is not belt-and-braces. Checking
    // ownsLeague(resource.data.leagueId) asks who owns the league the document is
    // in NOW, and says nothing about the league it is being moved TO. So a
    // registered user could create a result in their own league — correctly
    // allowed — and then update it, setting leagueId to a victim's league and
    // points to anything they liked. The rule would read the stored leagueId,
    // still their own, and pass. The document lands in the victim's standings.
    //
    // The create path was closed against exactly this attack; the update path
    // reopened it one write later.
    function staysInLeague() {
      return request.resource.data.leagueId == resource.data.leagueId;
    }

    // get vs list, split like leagues and activeTournaments below. `read: if
    // true` covered list as well as get, so one unauthenticated REST call
    // could paginate out every player's real name across every league in the
    // app, plus every result and every season structure — not just the ones a
    // caller has any connection to. A participant genuinely does need to LIST
    // these (filtered by leagueId), and Firestore rules cannot see a query's
    // where clause — only which documents a list call would return — so the
    // filter itself cannot be enforced here. What can be enforced is that the
    // caller has SOME session: the participant view already signs every
    // visitor in anonymously, so this costs a real user nothing and turns "one
    // curl, no account" into "mint a session first" — it does not stop a
    // determined scraper, but it ends casual, anonymous bulk enumeration.
    match /seasons/{seasonId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if request.resource.data.leagueId is string
        && ownsLeague(request.resource.data.leagueId);
      allow update: if ownsLeague(resource.data.leagueId) && staysInLeague();
      allow delete: if ownsLeague(resource.data.leagueId);
    }

    match /leaguePlayers/{playerId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if request.resource.data.leagueId is string
        && ownsLeague(request.resource.data.leagueId);
      allow update: if ownsLeague(resource.data.leagueId) && staysInLeague();
      allow delete: if ownsLeague(resource.data.leagueId);
    }

    match /tournamentResults/{resultId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if request.resource.data.leagueId is string
        && ownsLeague(request.resource.data.leagueId);
      allow update: if ownsLeague(resource.data.leagueId) && staysInLeague();
      allow delete: if ownsLeague(resource.data.leagueId);
    }

    // Active Tournaments
    // - Anyone can read ONE tournament by id (anonymous QR participants included);
    //   only its owner can list them — see the get/list note on the match below
    // - Only a registered owner can create
    // - Owner can change anything
    // - Nobody else can change a live game. There used to be a branch letting any
    //   isAuthenticated() caller write players, the timer, the blinds and the
    //   level structure. isAuthenticated() includes ANONYMOUS sessions, and the
    //   participant view signs every QR visitor in anonymously — so any player
    //   who scanned the code could pause the clock or change the blinds. It also
    //   meant handover shared control instead of transferring it: the previous
    //   director kept writing after giving the game away.
    // - ownerId is unwritable by clients. Transfer-code handover was removed:
    //   handing a game over is now done by logging out so the next director
    //   signs in with the same account, which keeps the league, season and
    //   points system correct by construction.
    match /activeTournaments/{tournamentId} {
      // get vs list, split like leagues above. A participant arriving by QR knows
      // the tournament id and must be able to read that one document. Listing is
      // the owner's own query for resuming their live game — `read: if true`
      // covered list as well as get, so anyone could enumerate every tournament
      // in the database, which matters more now that every game is saved rather
      // than only published ones.
      allow get: if true;
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isRegistered() && isDocOwner();
      allow update: if (
        // Owner can change anything EXCEPT who owns it.
        //
        // isExistingDocOwner() validates the STORED ownerId and said nothing
        // about the incoming one, so the comment above claiming ownerId is
        // unwritable was not what the rule did. A director could hand a live
        // game to another account from the console — reinstating the very
        // transfer-code handover that was removed because it cost a live game —
        // or write a bad uid and lock themselves out permanently, since update,
        // delete and list all key on it.
        //
        // completedTournaments and tournamentTemplates below already pin it by
        // requiring isDocOwner() alongside isExistingDocOwner(). This is the
        // same pin, spelled explicitly because this branch is a disjunction.
        isAuthenticated() && isExistingDocOwner()
        && request.resource.data.ownerId == resource.data.ownerId
      ) || (
        // Player check-in (PlayerClaimView, reached from the QR code).
        //
        // Requires a session — anonymous is enough, and the participant view
        // already signs every visitor in that way.
        //
        // `claims` is a top-level map, playerId -> deviceId, and it is the ONLY
        // thing this branch may touch. It used to admit `players` instead
        // (hasOnly(['players']), array length preserved) — but that write had
        // exactly the same shape as every other players-array write, so the
        // rule could not tell "set my claim" apart from "rename this player" or
        // "eliminate this player". Any QR visitor could obtain an anonymous
        // session, and the director's own client (useTournament.ts) treats an
        // incoming isActive:false as a genuine elimination and spreads an
        // incoming active entry wholesale — so a hostile check-in write reached
        // the director's screen and the league standings as if the director had
        // done it. `claims` carries no gameplay data at all, so there is
        // nothing left in this branch for a hostile write to reach.
        //
        // `claims.size() <= players.size()` bounds it to at most one entry per
        // seat in the game — there is no legitimate reason for more.
        //
        // Still not airtight — anyone can obtain an anonymous session, so a
        // determined participant can claim or unclaim any seat, including one
        // that is not theirs. That is a much narrower hole than the one it
        // replaces: the worst it reaches is "who does this seat say claimed
        // it", never a player's name, chips, position or elimination state.
        // Closing it fully means writing server-side with the Admin SDK, which
        // needs a service account key; key creation is blocked by org policy on
        // this project. See the note in PlayerClaimView.
        isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claims'])
        && request.resource.data.claims is map
        && request.resource.data.claims.size() <= resource.data.players.size()
      );
      allow delete: if isRegistered() && isExistingDocOwner();
    }

    // League Settings
    //
    // get is public. The participant view renders standings using the
    // DIRECTOR's points system, so RealTimeLeagueTable reads the director's
    // settings doc as an anonymous user. Restricting read to the owner
    // silently denied that and fell back to DEFAULT_LEAGUE_SETTINGS, so
    // participants could be shown different points totals than the director.
    //
    // list is OWNER-ONLY, unlike seasons/leaguePlayers/tournamentResults
    // above, because this collection uniquely carries something worse than
    // game data: every director's Firebase uid. `read: if true` covering list
    // as well as get meant one unauthenticated call could harvest the uid of
    // every director who has ever configured a league, plus their leagueIds
    // and points config. lib/leagueSettingsId.ts's deterministic id is what
    // makes owner-only list safe to do without breaking the participant read
    // above: a director's CURRENT settings for a given league live at one
    // predictable document id, so a participant fetches it with get() and
    // never needs to list this collection at all. Only the director's own
    // management UI — saved formula templates, editing, switching between
    // several leagues' settings — genuinely needs to enumerate its own docs,
    // and isRegistered() && resource.data.userId == request.auth.uid is
    // exactly "your own", nothing more.
    //
    // Writes remain owner-only.
    match /leagueSettings/{settingId} {
      allow get: if true;
      allow list: if isRegistered() && resource.data.userId == request.auth.uid;
      allow create: if isRegistered() && isDocUser();
      allow update: if isRegistered() && isExistingDocUser()
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isRegistered() && isExistingDocUser();
    }

    // Completed Tournaments — private history, owner only.
    // Not publicly readable: unlike live standings these are a personal record
    // and participants have no reason to read them.
    match /completedTournaments/{recordId} {
      allow read: if isRegistered() && resource.data.ownerId == request.auth.uid;
      allow create: if isRegistered() && isDocOwner();
      allow update: if isRegistered() && isExistingDocOwner() && isDocOwner();
      allow delete: if isRegistered() && isExistingDocOwner();
    }

    // Tournament Templates — owner only
    match /tournamentTemplates/{templateId} {
      allow read: if isRegistered() && resource.data.ownerId == request.auth.uid;
      allow create: if isRegistered() && isDocOwner();
      allow update: if isRegistered() && isExistingDocOwner() && isDocOwner();
      allow delete: if isRegistered() && isExistingDocOwner();
    }
  }
}
