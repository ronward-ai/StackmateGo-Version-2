# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# Firebase configuration — get these from your Firebase project settings.
# VITE_FIREBASE_DATABASE_ID is the *named* Firestore database this app uses; the
# project contains more than one and only this app's belongs to it.
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"

# Server-side Firebase, used by the Stripe webhook via the Admin SDK.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_DATABASE_ID="your-firestore-database-id"

# Stripe. Only needed once payments are switched on.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Optional: a shared password gate over the whole app, and an API base
# override for pointing the client at a different server.
VITE_ACCESS_PASSWORD=""
VITE_API_BASE_URL=""
